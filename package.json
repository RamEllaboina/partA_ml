{
  "name": "firebase-employee-management",
  "version": "1.0.0",
  "description": "Scalable Firebase Realtime Database Employee Management System",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon src/index.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm install && npm run build",
    "init-db": "node scripts/init-database.js",
    "seed-firestore": "node scripts/seed-firestore.js",
    "test": "jest",
    "deploy-functions": "firebase deploy --only functions",
    "deploy-hosting": "npm run build && firebase deploy --only hosting",
    "deploy-all": "npm run build && firebase deploy"
  },
  "keywords": [
    "firebase",
    "employee-management",
    "realtime-database",
    "nodejs"
  ],
  "author": "Employee Management System",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase": "^10.7.1",
    "firebase-admin": "^12.0.0",
    "joi": "^17.11.0",
    "moment": "^2.29.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}